<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050505"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_kongo_hour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0ª HORA DA NOITE"
        android:textColor="#D4AF37"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/widget_gregorian_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="18:24"
        android:textColor="#FCEEBA"
        android:textSize="32sp"
        android:textStyle="bold" />

    <View
        android:layout_width="160dp"
        android:layout_height="1dp"
        android:background="#4A3B18"
        android:layout_marginVertical="6dp" />

    <TextView
        android:id="@+id/widget_kongo_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NVULA 6008 • LUA • JORNADA"
        android:textColor="#E6D5AC"
        android:textSize="12sp"
        android:letterSpacing="0.05" />

</LinearLayout>
